FROM alpine:3.21

ARG GIT_COMMIT=unset
ARG GIT_REF=unset
ARG BUILT_AT=unset
ARG REPO_NAME=unset
ARG PR_NO=unset
ARG STATIC_VALUE=unset
ARG SHELL_VALUE=unset
ARG BAD_PLACEHOLDER=unset

RUN test -n "$GIT_COMMIT" \
 && test "$GIT_REF" = "pr-$PR_NO" \
 && test -n "$BUILT_AT" \
 && test "$REPO_NAME" = "myk-org/for-testing-only" \
 && test "$STATIC_VALUE" = "plain" \
 && test -n "$SHELL_VALUE" \
 && test "$BAD_PLACEHOLDER" = "{revison}" \
 && echo "E2E_BUILD_INFO assertions passed"

CMD ["true"]
