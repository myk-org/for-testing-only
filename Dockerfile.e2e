FROM alpine:3.21

ARG GIT_COMMIT=unset
ARG GIT_REF=unset
ARG BUILT_AT=unset
ARG REPO_NAME=unset
ARG PR_NO=unset
ARG STATIC_VALUE=unset
ARG SHELL_VALUE=unset
ARG BAD_PLACEHOLDER=unset

RUN echo "E2E_BUILD_INFO commit=$GIT_COMMIT ref=$GIT_REF built_at=$BUILT_AT repo=$REPO_NAME pr=$PR_NO static=$STATIC_VALUE shell=$SHELL_VALUE bad=$BAD_PLACEHOLDER"
